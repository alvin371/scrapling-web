# Managed by Ansible — do not edit by hand. Rendered on deploy from CI secrets.
# PostgreSQL (dedicated container in the scrapling-web stack)
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
DB_HOST=postgres
DB_PORT=5432

# Redis (in-stack)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# App
APP_ENV=production
SECRET_KEY={{ secret_key }}
LOG_LEVEL=INFO
CORS_ORIGINS={{ cors_origins }}

# Scrapling
SCRAPLING_PROXY={{ scrapling_proxy | default('') }}

# RQ
RQ_QUEUES=high,default,low

# Auth
API_KEYS={{ api_keys }}

# Session cookies
INSTAGRAM_SESSION_ID={{ instagram_session_id | default('') }}
THREADS_SESSION_ID={{ threads_session_id | default('') }}
