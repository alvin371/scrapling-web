# PostgreSQL
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_pass
POSTGRES_DB=social_scraper
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# App
APP_ENV=development
SECRET_KEY=change-this-in-production
LOG_LEVEL=INFO
LOG_PATH=logs/app.log

# Scrapling — optional proxy for stealth fetcher
SCRAPLING_PROXY=           # e.g. http://user:pass@host:port

# Instagram session cookie (required for authenticated scraping)
INSTAGRAM_SESSION_ID=

# Threads session cookie (required only for view counts via "Post activity" modal)
THREADS_SESSION_ID=

# RQ
RQ_QUEUES=high,default,low

# API Key Authentication
# Comma-separated list of valid API keys.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Multiple clients: API_KEYS=key1,key2,key3
API_KEYS=change-this-api-key-in-production
